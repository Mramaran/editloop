# Copy this file to .env.local and fill in one key. Never commit .env.local.
# The app works without any key by replaying the recorded run in cache/cache.json.

# Live model calls only happen when this is 1. Leave it unset on a public deployment.
# ALLOW_LIVE=1

# Used first if set. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.1-flash-lite

# Used if there is no Gemini key. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default OpenRouter model
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
