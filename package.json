{
  "name": "editloop",
  "version": "0.1.0",
  "private": true,
  "description": "A support-reply copilot that learns readable rules from human edits.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "record": "tsx --env-file-if-exists=.env.local scripts/record.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
